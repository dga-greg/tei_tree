# Copy to deploy/.env and replace every value marked CHANGE.
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
# Trying the stack on http://localhost only. On a server: https APP_ORIGIN, COOKIE_SECURE=true and remove this.
ALLOW_INSECURE_HTTP=true
# 32+ random characters each, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=CHANGE-me-to-a-long-random-string-of-at-least-32-chars
CSRF_SECRET=CHANGE-me-to-another-long-random-string-of-32-chars
# Encrypts the secrets of authenticator apps (two-step sign-in). Keep it: a new key turns two-step sign-in off for everyone.
MFA_ENCRYPTION_KEY=CHANGE-me-to-a-third-long-random-string-of-32-chars
S3_ACCESS_KEY_ID=familyheritage
S3_SECRET_ACCESS_KEY=CHANGE-me-storage-secret
S3_BUCKET=family-media
S3_PUBLIC_ENDPOINT=http://localhost:8333
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=Family Heritage <no-reply@localhost>

# Street maps on the Places page. Use a tile service you are allowed to use (OpenStreetMap's own tiles are for
# light use only: https://operations.osmfoundation.org/policies/tiles/). Leave empty for a plain map.
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# The tile service's origin, allowed by the web app's Content-Security-Policy, e.g. https://tile.openstreetmap.org
MAP_TILE_ORIGINS=

# Automatic transcripts of recordings (optional): an OpenAI-compatible speech-to-text endpoint.
# e.g. https://api.openai.com/v1/audio/transcriptions, or a self-hosted Whisper server with the same API.
TRANSCRIPTION_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# "Continue with Google" (optional). In Google Cloud Console → APIs & Services → Credentials, create an OAuth client
# of type "Web application" with the redirect URI <APP_ORIGIN>/api/v1/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Platform administrators must use two-step sign-in for the administration pages (true by default).
ADMIN_MFA_REQUIRED=true
