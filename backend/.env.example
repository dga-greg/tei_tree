# ---- Runtime ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Number of reverse-proxy hops in front of the API (for correct client IPs / secure cookies)
TRUST_PROXY=0
# Public URL of the web application (used in e-mail links). The SPA and the API must be served
# from the same origin in production (e.g. https://heritage.example.org and https://heritage.example.org/api).
APP_ORIGIN=http://localhost:4200

# ---- Data stores ----
# MongoDB must be a replica set (transactions). docker-compose.yml starts a single-node one.
MONGODB_URI=mongodb://localhost:27017/family_heritage?replicaSet=rs0
# Optional in development, required in production (shared rate limits + background jobs).
REDIS_URL=redis://localhost:6379

# ---- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ----
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
CSRF_SECRET=change-me-to-another-long-random-string-of-32-chars

# ---- Sessions ----
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_MAX_LIFETIME_DAYS=90
# Sign out after this many minutes without activity ("Keep me signed in" skips it); 0 turns it off.
IDLE_TIMEOUT_MINUTES=30
# Defaults to true when NODE_ENV=production
COOKIE_SECURE=false

# ---- Password hashing (Argon2id) ----
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30

# ---- Rate limits ----
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_15_MINUTES=10

# ---- E-mail ----
# Leave empty in development to log e-mails instead of sending them. Required in production.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Family Heritage <no-reply@heritage.example.org>"

# ---- Generations ----
# Families with more people than this are recalculated by the worker instead of within the request.
GENERATION_INLINE_LIMIT=2000

# Uploaded files. `local` keeps them in MEDIA_LOCAL_DIR and serves them through HMAC-signed links
# (development only); production requires `s3` (AWS S3, Cloudflare R2, MinIO, …). Buckets stay private.
STORAGE_DRIVER=local
MEDIA_LOCAL_DIR=./var/media
# S3_BUCKET=family-heritage-media
# S3_REGION=eu-west-1
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
MEDIA_MAX_UPLOAD_MB=50
MEDIA_URL_TTL_SECONDS=300


# Street maps on the Places page (leave unset for a plain map). Use a tile service you may use;
# OpenStreetMap's own tiles are for light use only (https://operations.osmfoundation.org/policies/tiles/).
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# MAP_TILE_MAX_ZOOM=18

# Automatic transcripts of recordings: an OpenAI-compatible speech-to-text endpoint (unset = off).
# TRANSCRIPTION_URL=https://api.openai.com/v1/audio/transcriptions
# TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_MODEL=whisper-1
# TRANSCRIPTION_MAX_MB=25

# Two-step sign-in. MFA_ENCRYPTION_KEY encrypts authenticator secrets (defaults to a key derived from
# JWT_ACCESS_SECRET; set it in production and keep it). Administrators need two-step sign-in for /admin.
# MFA_ENCRYPTION_KEY=
# ADMIN_MFA_REQUIRED=true

# "Continue with Google": an OAuth client (Web application) whose redirect URI is
# <APP_ORIGIN>/api/v1/auth/google/callback, e.g. http://localhost:4200/api/v1/auth/google/callback in development.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
