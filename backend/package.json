{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "create-super-admin": "tsx --env-file-if-exists=.env src/scripts/create-super-admin.ts",
    "purge": "tsx --env-file-if-exists=.env src/scripts/purge.ts",
    "reminders": "tsx --env-file-if-exists=.env src/scripts/reminders.ts",
    "vapid": "tsx src/scripts/vapid.ts",
    "purge:prod": "node dist/scripts/purge.js",
    "perf": "tsx perf/perf.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@fh/contracts": "*",
    "argon2": "^0.45.1",
    "bullmq": "^5.0.0",
    "busboy": "^1.6.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "file-type": "^22.2.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "nodemailer": "^10.1.2",
    "pdfkit": "^0.17.2",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.2.0",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/compression": "^1.8.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pdfkit": "^0.17.3",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "mongodb-memory-server": "^10.2.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
